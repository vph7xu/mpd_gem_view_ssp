gem.pro:
qmake: FORCE
	@$(QMAKE) -o Makefile.gem gem.pro

qmake_all: FORCE


all: Makefile.gem lib/libgem.so.1.0.0

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents /sfs/gpfs/tardis/applications/202606/software/standard/compiler/gcc/14.2.0/qt5/5.15.16/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents include/GEMStruct.h include/GEMPedestal.h include/GEMAPV.h include/GEMMPD.h include/GEMPlane.h include/GEMSystem.h third_party/ConfigObject.h third_party/ConfigOption.h third_party/ConfigParser.h third_party/ConfigValue.h third_party/ConfigArgs.h include/GEMCluster.h include/GEMDetector.h include/GEMDetectorLayer.h include/GEMException.h include/GEMDataHandler.h include/APVStripMapping.h include/GEMRootHitTree.h include/GEMRootClusterTree.h include/PreAnalysis.h include/hardcode.h include/Cuts.h include/ValueType.h include/APVStripMapping.h include/PixelMapping.h $(DISTDIR)/
	$(COPY_FILE) --parents src/GEMPedestal.cpp src/GEMAPV.cpp src/GEMMPD.cpp src/GEMPlane.cpp src/GEMSystem.cpp third_party/ConfigObject.cpp third_party/ConfigOption.cpp third_party/ConfigParser.cpp third_party/ConfigValue.cpp third_party/ConfigArgs.cpp src/GEMCluster.cpp src/GEMDetector.cpp src/GEMDetectorLayer.cpp src/GEMException.cpp src/GEMDataHandler.cpp src/GEMRootHitTree.cpp src/GEMRootClusterTree.cpp src/APVStripMapping.cpp src/PreAnalysis.cpp src/Cuts.cpp src/ValueType.cpp $(DISTDIR)/


clean: compiler_clean 
	-$(DEL_FILE) $(OBJECTS)
	-$(DEL_FILE) *~ core *.core


distclean: clean 
	-$(DEL_FILE) lib/$(TARGET) 
	-$(DEL_FILE) lib/$(TARGET0) lib/$(TARGET1) lib/$(TARGET2) $(TARGETA)
	-$(DEL_FILE) Makefile.gem


####### Sub-libraries

mocclean: compiler_moc_header_clean compiler_moc_objc_header_clean compiler_moc_source_clean

mocables: compiler_moc_header_make_all compiler_moc_objc_header_make_all compiler_moc_source_make_all

check: first

benchmark: first

compiler_rcc_make_all:
compiler_rcc_clean:
compiler_moc_predefs_make_all: moc/moc_predefs.h
compiler_moc_predefs_clean:
	-$(DEL_FILE) moc/moc_predefs.h
moc/moc_predefs.h: /sfs/gpfs/tardis/applications/202606/software/standard/compiler/gcc/14.2.0/qt5/5.15.16/mkspecs/features/data/dummy.cpp
	g++ -m64 -pipe -std=c++17 -g -O2 -Wall -Wextra -dM -E -o moc/moc_predefs.h /sfs/gpfs/tardis/applications/202606/software/standard/compiler/gcc/14.2.0/qt5/5.15.16/mkspecs/features/data/dummy.cpp

compiler_moc_header_make_all:
compiler_moc_header_clean:
compiler_moc_objc_header_make_all:
compiler_moc_objc_header_clean:
compiler_moc_source_make_all:
compiler_moc_source_clean:
compiler_yacc_decl_make_all:
compiler_yacc_decl_clean:
compiler_yacc_impl_make_all:
compiler_yacc_impl_clean:
compiler_lex_make_all:
compiler_lex_clean:
compiler_clean: compiler_moc_predefs_clean 

####### Compile

obj/GEMPedestal.o: src/GEMPedestal.cpp include/GEMPedestal.h \
		../decoder/include/MPDDataStruct.h \
		include/GEMStruct.h \
		../decoder/include/EvioFileReader.h \
		../third_party/evio-5.2/evio.h \
		../third_party/evio-5.2/msinttypes.h \
		../decoder/include/EventParser.h \
		../decoder/include/GeneralEvioStruct.h \
		../decoder/include/AbstractRawDecoder.h \
		../decoder/include/MPDVMERawEventDecoder.h \
		../decoder/include/RolStruct.h \
		../decoder/include/MPDSSPRawEventDecoder.h \
		include/hardcode.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/GEMPedestal.o src/GEMPedestal.cpp

obj/GEMAPV.o: src/GEMAPV.cpp ../decoder/include/MPDDataStruct.h \
		include/GEMSystem.h \
		include/GEMDetector.h \
		include/GEMStruct.h \
		include/GEMPlane.h \
		include/GEMAPV.h \
		../decoder/include/MPDSSPRawEventDecoder.h \
		../decoder/include/AbstractRawDecoder.h \
		../decoder/include/RolStruct.h \
		third_party/ConfigParser.h \
