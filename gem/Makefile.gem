		include/GEMMPD.h \
		include/GEMCluster.h \
		third_party/ConfigObject.h \
		include/APVStripMapping.h \
		../decoder/include/SRSRawEventDecoder.h \
		include/hardcode.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/GEMAPV.o src/GEMAPV.cpp

obj/GEMMPD.o: src/GEMMPD.cpp include/GEMMPD.h \
		include/GEMAPV.h \
		../decoder/include/MPDDataStruct.h \
		include/GEMStruct.h \
		../decoder/include/MPDSSPRawEventDecoder.h \
		../decoder/include/AbstractRawDecoder.h \
		../decoder/include/RolStruct.h \
		include/GEMSystem.h \
		include/GEMDetector.h \
		include/GEMPlane.h \
		third_party/ConfigParser.h \
