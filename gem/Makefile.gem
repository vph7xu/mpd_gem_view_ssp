	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/GEMMPD.o src/GEMMPD.cpp

obj/GEMPlane.o: src/GEMPlane.cpp include/GEMPlane.h \
		include/GEMAPV.h \
