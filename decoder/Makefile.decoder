decoder.pro:
qmake: FORCE
	@$(QMAKE) -o Makefile.decoder decoder.pro

qmake_all: FORCE


all: Makefile.decoder lib/libdecoder.so.1.0.0

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents /sfs/gpfs/tardis/applications/202606/software/standard/compiler/gcc/14.2.0/qt5/5.15.16/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents include/EvioFileReader.h include/EventParser.h include/GeneralEvioStruct.h include/MPDVMERawEventDecoder.h include/MPDSSPRawEventDecoder.h include/RolStruct.h include/MPDDataStruct.h include/AbstractRawDecoder.h include/sspApvdec.h include/TriggerDecoder.h include/SRSRawEventDecoder.h ../third_party/evio-5.2/evio.h ../third_party/evio-5.2/msinttypes.h $(DISTDIR)/
	$(COPY_FILE) --parents src/EvioFileReader.cpp src/EventParser.cpp src/MPDVMERawEventDecoder.cpp src/MPDSSPRawEventDecoder.cpp src/AbstractRawDecoder.cpp src/MPDDataStruct.cpp src/TriggerDecoder.cpp src/SRSRawEventDecoder.cpp ../third_party/evio-5.2/evio.c ../third_party/evio-5.2/eviofmt.c ../third_party/evio-5.2/eviofmtdump.c ../third_party/evio-5.2/eviofmtswap.c ../third_party/evio-5.2/evioswap.c $(DISTDIR)/


clean: compiler_clean 
	-$(DEL_FILE) $(OBJECTS)
	-$(DEL_FILE) *~ core *.core


distclean: clean 
	-$(DEL_FILE) lib/$(TARGET) 
	-$(DEL_FILE) lib/$(TARGET0) lib/$(TARGET1) lib/$(TARGET2) $(TARGETA)
	-$(DEL_FILE) Makefile.decoder


####### Sub-libraries

mocclean: compiler_moc_header_clean compiler_moc_objc_header_clean compiler_moc_source_clean

mocables: compiler_moc_header_make_all compiler_moc_objc_header_make_all compiler_moc_source_make_all

check: first

benchmark: first

compiler_rcc_make_all:
compiler_rcc_clean:
compiler_moc_predefs_make_all: moc/moc_predefs.h
compiler_moc_predefs_clean:
	-$(DEL_FILE) moc/moc_predefs.h
moc/moc_predefs.h: /sfs/gpfs/tardis/applications/202606/software/standard/compiler/gcc/14.2.0/qt5/5.15.16/mkspecs/features/data/dummy.cpp
	g++ -m64 -pipe -std=c++17 -g -O2 -Wall -Wextra -dM -E -o moc/moc_predefs.h /sfs/gpfs/tardis/applications/202606/software/standard/compiler/gcc/14.2.0/qt5/5.15.16/mkspecs/features/data/dummy.cpp

compiler_moc_header_make_all:
compiler_moc_header_clean:
compiler_moc_objc_header_make_all:
compiler_moc_objc_header_clean:
compiler_moc_source_make_all:
compiler_moc_source_clean:
compiler_yacc_decl_make_all:
compiler_yacc_decl_clean:
compiler_yacc_impl_make_all:
compiler_yacc_impl_clean:
compiler_lex_make_all:
compiler_lex_clean:
compiler_clean: compiler_moc_predefs_clean 

####### Compile

obj/EvioFileReader.o: src/EvioFileReader.cpp include/EvioFileReader.h \
		../third_party/evio-5.2/evio.h \
		../third_party/evio-5.2/msinttypes.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/EvioFileReader.o src/EvioFileReader.cpp

obj/EventParser.o: src/EventParser.cpp include/EventParser.h \
		include/GeneralEvioStruct.h \
		include/AbstractRawDecoder.h \
		include/MPDDataStruct.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/EventParser.o src/EventParser.cpp

obj/MPDVMERawEventDecoder.o: src/MPDVMERawEventDecoder.cpp include/MPDVMERawEventDecoder.h \
		include/RolStruct.h \
		include/MPDDataStruct.h \
		include/AbstractRawDecoder.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/MPDVMERawEventDecoder.o src/MPDVMERawEventDecoder.cpp

obj/MPDSSPRawEventDecoder.o: src/MPDSSPRawEventDecoder.cpp include/MPDSSPRawEventDecoder.h \
		include/AbstractRawDecoder.h \
		include/MPDDataStruct.h \
		include/RolStruct.h \
		include/sspApvdec.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/MPDSSPRawEventDecoder.o src/MPDSSPRawEventDecoder.cpp

obj/AbstractRawDecoder.o: src/AbstractRawDecoder.cpp include/AbstractRawDecoder.h \
		include/MPDDataStruct.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/AbstractRawDecoder.o src/AbstractRawDecoder.cpp

obj/MPDDataStruct.o: src/MPDDataStruct.cpp include/MPDDataStruct.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/MPDDataStruct.o src/MPDDataStruct.cpp

obj/TriggerDecoder.o: src/TriggerDecoder.cpp include/TriggerDecoder.h \
		include/AbstractRawDecoder.h \
		include/MPDDataStruct.h \
		include/sspApvdec.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/TriggerDecoder.o src/TriggerDecoder.cpp

obj/SRSRawEventDecoder.o: src/SRSRawEventDecoder.cpp include/SRSRawEventDecoder.h \
		include/MPDDataStruct.h \
		include/AbstractRawDecoder.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/SRSRawEventDecoder.o src/SRSRawEventDecoder.cpp

obj/evio.o: ../third_party/evio-5.2/evio.c ../third_party/evio-5.2/evio.h \
		../third_party/evio-5.2/msinttypes.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o obj/evio.o ../third_party/evio-5.2/evio.c

obj/eviofmt.o: ../third_party/evio-5.2/eviofmt.c ../third_party/evio-5.2/evio.h \
		../third_party/evio-5.2/msinttypes.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o obj/eviofmt.o ../third_party/evio-5.2/eviofmt.c

obj/eviofmtdump.o: ../third_party/evio-5.2/eviofmtdump.c 
	$(CC) -c $(CFLAGS) $(INCPATH) -o obj/eviofmtdump.o ../third_party/evio-5.2/eviofmtdump.c

obj/eviofmtswap.o: ../third_party/evio-5.2/eviofmtswap.c ../third_party/evio-5.2/evio.h \
		../third_party/evio-5.2/msinttypes.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o obj/eviofmtswap.o ../third_party/evio-5.2/eviofmtswap.c

obj/evioswap.o: ../third_party/evio-5.2/evioswap.c ../third_party/evio-5.2/evio.h \
		../third_party/evio-5.2/msinttypes.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o obj/evioswap.o ../third_party/evio-5.2/evioswap.c

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/sfs/ceph/standard/sbs/CERN_BEAM_TEST/mpd_gem_view_ssp_cern/mpd_gem_view_ssp/decoder/./lib || mkdir -p $(INSTALL_ROOT)/sfs/ceph/standard/sbs/CERN_BEAM_TEST/mpd_gem_view_ssp_cern/mpd_gem_view_ssp/decoder/./lib
