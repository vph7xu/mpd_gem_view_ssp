QMAKE_TARGET  = tracking_dev
DESTDIR       = lib/
TARGET        = libtracking_dev.so.1.0.0
TARGETA       = lib/libtracking_dev.a
TARGET0       = libtracking_dev.so
TARGETD       = libtracking_dev.so.1.0.0
TARGET1       = libtracking_dev.so.1
TARGET2       = libtracking_dev.so.1.0


first: all
####### Build rules

lib/libtracking_dev.so.1.0.0:  $(OBJECTS) $(SUBLIBS) $(OBJCOMP)  
	@test -d lib/ || mkdir -p lib/
	-$(DEL_FILE) $(TARGET) $(TARGET0) $(TARGET1) $(TARGET2)
	$(LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(LIBS) $(OBJCOMP)
	-ln -s $(TARGET) $(TARGET0)
	-ln -s $(TARGET) $(TARGET1)
	-ln -s $(TARGET) $(TARGET2)
	-$(DEL_FILE) lib/$(TARGET)
	-$(MOVE) $(TARGET) lib/$(TARGET)
	-$(DEL_FILE) lib/$(TARGET0)
	-$(DEL_FILE) lib/$(TARGET1)
	-$(DEL_FILE) lib/$(TARGET2)
	-$(MOVE) $(TARGET0) lib/$(TARGET0)
	-$(MOVE) $(TARGET1) lib/$(TARGET1)
	-$(MOVE) $(TARGET2) lib/$(TARGET2)



staticlib: lib/libtracking_dev.a

lib/libtracking_dev.a:  $(OBJECTS) $(OBJCOMP) 
	-$(DEL_FILE) $(TARGETA) 
	$(AR) $(TARGETA) $(OBJECTS)

